// RotaCerta v2 - Prisma Schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================
//  Enums
// ==============================
enum Role {
  ADMIN
  DRIVER
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  ARRIVED
  COMPLETED
  FAILED
  CANCELED
}

enum RouteStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELED
}

enum FailureCode {
  CUSTOMER_ABSENT
  WRONG_ADDRESS
  CUSTOMER_REFUSED
  VEHICLE_PROBLEM
  DAMAGE
  OTHER
}

enum AlertType {
  DELAY
  DEVIATION
  LONG_STOP
  DELIVERY_COMPLETED
  DELIVERY_FAILED
  ROUTE_STARTED
  NEW_DELIVERY
  MAINTENANCE
  SHIFT_STARTED
  SHIFT_ENDED
  GPS_SUSPECT
}

// ==============================
//  Users & Auth
// ==============================
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role
  avatarUrl     String?
  // 2FA (TOTP)
  totpSecret    String?
  totpEnabled   Boolean  @default(false)
  active        Boolean  @default(true)
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  driver            Driver?
  auditLogs         AuditLog[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  pushSubscriptions PushSubscription[]

  @@index([role])
  @@index([isDemo])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==============================
//  Driver profile & Vehicle
// ==============================
model Driver {
  id            String   @id @default(cuid())
  userId        String   @unique
  phone         String?
  licenseNumber String?
  vehiclePlate  String?
  vehicleModel  String?
  totalKmDriven Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?
  routes        Route[]
  deliveries    Delivery[]
  pings         LocationPing[]
  shifts        Shift[]
  chatMessages  ChatMessage[]

  @@index([userId])
}

model Vehicle {
  id                 String   @id @default(cuid())
  driverId           String   @unique
  plate              String
  model              String
  fuelConsumptionKmL Float    @default(10.0)
  fuelPricePerLiter  Float    @default(5.80)
  maintenanceKmLimit Float    @default(10000)
  kmSinceMaintenance Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}

// ==============================
//  Customers
// ==============================
model Customer {
  id         String   @id @default(cuid())
  name       String
  phone      String?
  email      String?
  address    String
  city       String?
  state      String?
  zipCode    String?
  latitude   Float
  longitude  Float
  notes      String?
  isTest     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deliveries Delivery[]

  @@index([name])
  @@index([isTest])
}

// ==============================
//  Routes & Deliveries
// ==============================
model Route {
  id           String      @id @default(cuid())
  name         String
  status       RouteStatus @default(PLANNED)
  driverId     String?
  scheduledFor DateTime
  startedAt    DateTime?
  endedAt      DateTime?
  distanceKm   Float       @default(0)
  fuelUsedLiters Float     @default(0)
  fuelCostBrl  Float       @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  driver        Driver?        @relation(fields: [driverId], references: [id])
  deliveries    Delivery[]
  pings         LocationPing[]
  trackingLinks TrackingLink[]

  @@index([status])
  @@index([driverId])
}

model Delivery {
  id           String         @id @default(cuid())
  routeId      String?
  customerId   String
  driverId     String?
  sequence     Int            @default(0)
  status       DeliveryStatus @default(PENDING)
  scheduledAt  DateTime?
  arrivedAt    DateTime?
  completedAt  DateTime?
  arrivedLat   Float?
  arrivedLng   Float?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  route    Route?     @relation(fields: [routeId], references: [id])
  customer Customer   @relation(fields: [customerId], references: [id])
  driver   Driver?    @relation(fields: [driverId], references: [id])
  proof    ProofOfDelivery?
  failure  DeliveryFailure?

  @@index([status])
  @@index([routeId])
  @@index([driverId])
}

model ProofOfDelivery {
  id         String   @id @default(cuid())
  deliveryId String   @unique
  photoUrl   String
  latitude   Float
  longitude  Float
  notes      String?
  createdAt  DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model DeliveryFailure {
  id         String      @id @default(cuid())
  deliveryId String      @unique
  code       FailureCode
  notes      String?
  photoUrl   String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime    @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

// ==============================
//  Real-time tracking
// ==============================
model LocationPing {
  id         String   @id @default(cuid())
  driverId   String
  routeId    String?
  latitude   Float
  longitude  Float
  speed      Float?
  heading    Float?
  accuracy   Float?
  suspect       Boolean @default(false)
  suspectReason String?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  route  Route? @relation(fields: [routeId], references: [id])

  @@index([driverId, recordedAt])
  @@index([routeId])
}

// ==============================
//  Notifications & Audit
// ==============================
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      AlertType
  title     String
  body      String
  data      Json?
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

// ==============================
//  System settings
// ==============================
model SystemSettings {
  id            String   @id @default("settings")
  companyName   String   @default("RotaCerta")
  logoUrl       String?
  accentColor   String   @default("#0EA5E9")
  hqAddress     String?
  hqLatitude    Float?
  hqLongitude   Float?
  hqRadiusM     Float    @default(150)
  updatedAt     DateTime @updatedAt
}

// ==============================
//  Shift
// ==============================
model Shift {
  id           String    @id @default(cuid())
  driverId     String
  date         DateTime
  checkInAt    DateTime
  checkInLat   Float?
  checkInLng   Float?
  autoCheckIn  Boolean   @default(false)
  checkOutAt   DateTime?
  checkOutLat  Float?
  checkOutLng  Float?
  autoCheckOut Boolean   @default(false)
  createdAt    DateTime  @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, date])
  @@index([driverId])
  @@index([date])
}

// ==============================
//  Chat Message
// ==============================
model ChatMessage {
  id         String   @id @default(cuid())
  driverId   String
  senderId   String
  senderRole Role
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt])
  @@index([driverId, read])
}

// ==============================
//  Tracking Link
// ==============================
model TrackingLink {
  id        String    @id @default(cuid())
  token     String    @unique
  routeId   String
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
}

// ==============================
//  Web Push
// ==============================
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
